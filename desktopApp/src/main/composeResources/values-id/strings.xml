    <string name="vendor_xiaomi_name">Xiaomi / POCO</string>
    <string name="vendor_xiaomi_full">Xiaomi · Redmi · POCO</string>
    <string name="vendor_xiaomi_skin">HyperOS &amp; MIUI</string>
    <string name="vendor_xiaomi_step_1">Buka Info Aplikasi Rimalux dan aktifkan Mulai otomatis (Autostart).</string>
    <string name="vendor_xiaomi_step_2">Ketuk Penghemat baterai (atau Baterai) lalu pilih Tanpa pembatasan (No restrictions).</string>
    <string name="vendor_xiaomi_step_3">Buka Aplikasi Terkini (Recent Apps), tekan dan tahan kartu Rimalux (atau ketuk menu), lalu ketuk ikon Gembok agar tidak terhapus saat membersihkan memori.</string>

    <string name="vendor_samsung_name">Samsung</string>
    <string name="vendor_samsung_full">Samsung Galaxy</string>
    <string name="vendor_samsung_skin">One UI</string>
    <string name="vendor_samsung_step_1">Buka Info Aplikasi Rimalux, ketuk Baterai, lalu pilih Tidak dibatasi (Unrestricted).</string>
    <string name="vendor_samsung_step_2">Buka Pengaturan → Baterai → Batas penggunaan latar belakang, lalu hapus Rimalux dari Aplikasi tidur dan Aplikasi tidur pulas.</string>
    <string name="vendor_samsung_step_3">Di Batas penggunaan latar belakang, ketuk Aplikasi tidak pernah tidur otomatis → + lalu tambahkan Rimalux.</string>

    <string name="vendor_oppo_name">OPPO / OnePlus</string>
    <string name="vendor_oppo_full">OPPO · Realme · OnePlus</string>
    <string name="vendor_oppo_skin">ColorOS, Realme UI &amp; OxygenOS</string>
    <string name="vendor_oppo_step_1">Buka Info Aplikasi Rimalux → Penggunaan baterai (atau Baterai), lalu aktifkan Izinkan aktivitas latar belakang dan Izinkan peluncuran otomatis.</string>
    <string name="vendor_oppo_step_2">Jika muncul opsi Optimalkan penggunaan baterai, atur Rimalux ke Jangan optimalkan / Tidak dibatasi.</string>
    <string name="vendor_oppo_step_3">Di Aplikasi Terkini (Recent Apps), ketuk menu tiga titik di atas Rimalux lalu pilih Kunci (Lock).</string>

    <string name="vendor_vivo_name">Vivo / iQOO</string>
    <string name="vendor_vivo_full">Vivo · iQOO</string>
    <string name="vendor_vivo_skin">Funtouch OS &amp; OriginOS</string>
    <string name="vendor_vivo_step_1">Buka Info Aplikasi Rimalux → Baterai, lalu pilih Tidak dibatasi (atau aktifkan Konsumsi daya latar belakang tinggi).</string>
    <string name="vendor_vivo_step_2">Buka Pengaturan → Aplikasi → Mulai otomatis (atau iManager → Manajer aplikasi → Manajer mulai otomatis) dan aktifkan Rimalux.</string>
    <string name="vendor_vivo_step_3">Di Aplikasi Terkini (Recent Apps), ketuk panah di samping Rimalux lalu pilih Kunci (Lockdown / Lock).</string>

    <string name="vendor_huawei_name">Huawei / Honor</string>
    <string name="vendor_huawei_full">Huawei · Honor</string>
    <string name="vendor_huawei_skin">EMUI &amp; MagicOS</string>
    <string name="vendor_huawei_step_1">Buka Pengaturan → Baterai → Peluncuran aplikasi, cari Rimalux, lalu matikan Kelola secara otomatis.</string>
    <string name="vendor_huawei_step_2">Pada jendela manual yang muncul, biarkan Peluncuran otomatis, Peluncuran sekunder, dan Jalankan di latar belakang tetap aktif, lalu ketuk OK.</string>
    <string name="vendor_huawei_step_3">Di Aplikasi Terkini (Recent Apps), tarik kartu Rimalux ke bawah hingga ikon gembok muncul.</string>

    <string name="vendor_asus_name">ASUS</string>
    <string name="vendor_asus_full">ASUS Zenfone &amp; ROG</string>
    <string name="vendor_asus_skin">ZenUI &amp; ROG UI</string>
    <string name="vendor_asus_step_1">Buka Mobile Manager → PowerMaster → Auto-start Manager lalu ubah Rimalux menjadi Izinkan (Allow).</string>
    <string name="vendor_asus_step_2">Buka Info Aplikasi Rimalux → Baterai lalu pilih Tidak dibatasi (Unrestricted).</string>
    <string name="vendor_asus_step_3">Jika Mode Sistem / Mode hemat ultra aktif di Armoury Crate atau Baterai, kecualikan Rimalux dari pembersihan latar belakang.</string>

    <string name="vendor_stock_name">Pixel / Standar</string>
    <string name="vendor_stock_full">Google Pixel · Motorola · Nothing · Sony</string>
    <string name="vendor_stock_skin">Android Standar</string>
    <string name="vendor_stock_step_1">Buka Info Aplikasi Rimalux → Penggunaan baterai aplikasi.</string>
    <string name="vendor_stock_step_2">Aktifkan Izinkan penggunaan latar belakang, lalu ketuk baris teks Izinkan penggunaan latar belakang (bukan hanya sakelarnya) dan pilih Tidak dibatasi.</string>
    <string name="vendor_stock_step_3">Hindari menekan Paksa berhenti (Force stop) di Info Aplikasi, karena Android membatalkan semua jadwal aplikasi yang dihentikan paksa hingga aplikasi dibuka kembali.</string>

