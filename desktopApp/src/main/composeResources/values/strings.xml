    <string name="vendor_xiaomi_step_2">Tap Battery saver (or Battery) and choose No restrictions instead of MIUI Battery saver.</string>
    <string name="vendor_xiaomi_step_3">Open Recent Apps, press and hold the Rimalux card (or tap the menu), and tap the Lock padlock icon so clearing Recents does not kill timers.</string>

    <string name="vendor_samsung_name">Samsung</string>
    <string name="vendor_samsung_full">Samsung Galaxy</string>
    <string name="vendor_samsung_skin">One UI</string>
    <string name="vendor_samsung_step_1">Open App Info for Rimalux, tap Battery, and select Unrestricted.</string>
    <string name="vendor_samsung_step_2">Open Settings → Battery → Background usage limits, and remove Rimalux from Sleeping apps and Deep sleeping apps.</string>
    <string name="vendor_samsung_step_3">In Background usage limits, tap Never auto sleeping apps → + and add Rimalux.</string>

    <string name="vendor_oppo_name">OPPO / OnePlus</string>
    <string name="vendor_oppo_full">OPPO · Realme · OnePlus</string>
    <string name="vendor_oppo_skin">ColorOS, Realme UI &amp; OxygenOS</string>
    <string name="vendor_oppo_step_1">Open App Info for Rimalux → Battery usage (or Battery), and enable Allow background activity and Allow auto-launch.</string>
    <string name="vendor_oppo_step_2">If an Optimize battery use option is shown, set Rimalux to Don’t optimize / Unrestricted.</string>
    <string name="vendor_oppo_step_3">In Recent Apps, tap the three-dot menu above Rimalux and select Lock to prevent background termination.</string>

    <string name="vendor_vivo_name">Vivo / iQOO</string>
    <string name="vendor_vivo_full">Vivo · iQOO</string>
    <string name="vendor_vivo_skin">Funtouch OS &amp; OriginOS</string>
    <string name="vendor_vivo_step_1">Open App Info for Rimalux → Battery, and select Unrestricted (or enable High background power consumption).</string>
    <string name="vendor_vivo_step_2">Go to Settings → Apps → Autostart (or iManager → App manager → Autostart manager) and toggle Rimalux on.</string>
    <string name="vendor_vivo_step_3">In Recent Apps, tap the arrow next to Rimalux and select Lockdown / Lock.</string>

    <string name="vendor_huawei_name">Huawei / Honor</string>
    <string name="vendor_huawei_full">Huawei · Honor</string>
    <string name="vendor_huawei_skin">EMUI &amp; MagicOS</string>
    <string name="vendor_huawei_step_1">Open Settings → Battery → App launch, find Rimalux, and turn Manage automatically OFF.</string>
    <string name="vendor_huawei_step_2">In the manual popup that appears, keep Auto-launch, Secondary launch, and Run in background all enabled, then tap OK.</string>
    <string name="vendor_huawei_step_3">In Recent Apps, pull down on the Rimalux card to display the padlock icon.</string>

    <string name="vendor_asus_name">ASUS</string>
    <string name="vendor_asus_full">ASUS Zenfone &amp; ROG</string>
    <string name="vendor_asus_skin">ZenUI &amp; ROG UI</string>
    <string name="vendor_asus_step_1">Open Mobile Manager → PowerMaster → Auto-start Manager and switch Rimalux to Allow.</string>
    <string name="vendor_asus_step_2">Open App Info for Rimalux → Battery and select Unrestricted.</string>
    <string name="vendor_asus_step_3">If System Mode / Ultra-saving mode is enabled in Armoury Crate or Battery, exclude Rimalux from background cleanup.</string>

    <string name="vendor_stock_name">Pixel / Standard</string>
    <string name="vendor_stock_full">Google Pixel · Motorola · Nothing · Sony</string>
    <string name="vendor_stock_skin">Standard Android</string>
    <string name="vendor_stock_step_1">Open App Info for Rimalux → App battery usage.</string>
    <string name="vendor_stock_step_2">Enable Allow background usage, then tap the text row Allow background usage (not just the switch) and choose Unrestricted.</string>
    <string name="vendor_stock_step_3">Avoid using Force stop in App Info, as Android cancels all scheduled alarms for force-stopped apps until reopened.</string>

    <string name="auto_help_tip_title">Quick Recovery Tip</string>
    <string name="auto_help_tip_body">If auto-change ever stops, simply opening Rimalux once will automatically resume wallpaper auto-change.</string>

